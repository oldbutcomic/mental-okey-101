VITE_SERVER_URL=http://localhost:3001
# Leave empty for local development; accounts persist in .data/accounts.sqlite.
# Set a PostgreSQL URL to use PostgreSQL instead (required in production).
DATABASE_URL=
# Optional for local development. Production requires a private invite code for registration.
BETA_INVITE_CODE=
# Optional local SQLite file path. Defaults to .data/accounts.sqlite.
# ACCOUNT_SQLITE_PATH=.data/accounts.sqlite
